[Unit]
Description=CivSwitch USB HID macro
After=civswitch-gadget.service
Requires=civswitch-gadget.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/civswitch/civswitch.py /opt/civswitch/payload.txt
TimeoutStopSec=5
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
